[Unit]
Description=e1000e fast reproducer: constant small-MSS TSO to proxmox-5 alongside VM 900 guest traffic (temporary)
After=network-online.target
[Service]
ExecStart=/usr/bin/iperf3 -c 10.0.255.34 -p 5211 -M 536 -P 8 --bidir -t 86400
Restart=always
RestartSec=5s
[Install]
WantedBy=multi-user.target
